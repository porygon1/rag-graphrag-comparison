# Copy this file to .env and fill in your Azure values. Keep .env out of Git.
# Offline examples need no key. Azure requests require explicit notebook controls.

# Your Azure OpenAI resource endpoint, access key and supported API version.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Your Azure deployment name for gpt-4.1-mini.
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Your Azure deployment name for text-embedding-3-small (1536 dimensions).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Your Azure deployment name for text-embedding-3-large (1536 dimensions).
# Required for the EMBED and FINAL configurations.
AZURE_OPENAI_EMBEDDING_LARGE_DEPLOYMENT=

# Optional Azure deployment for structured assessment proposals. Human acceptance is required.
AZURE_OPENAI_JUDGE_DEPLOYMENT=
